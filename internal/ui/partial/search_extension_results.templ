package partial

import (
	"fmt"
	"strconv"

	"veloria/internal/ui"
	"veloria/internal/ui/icon"
)

func contextURL(searchID, searchDataSource, slug, filename string, lineNumber int) string {
	return "/search/" + searchID + "/context?repo=" + searchDataSource + "&slug=" + slug + "&file=" + filename + "&line=" + strconv.Itoa(lineNumber)
}

func matchCountLabel(count int) string {
	if count == 1 {
		return "1 match"
	}
	return fmt.Sprintf("%d matches", count)
}

templ SearchExtensionResults(data ui.ExtensionResultsData) {
	for _, file := range data.Result.Matches {
		<div class="result__file">
			<span class="result__file-icon">
				@icon.File(14, "")
			</span>
			<span class="result__file-path" title={ file.Filename }>{ file.Filename }</span>
			<span class="result__file-count">{ matchCountLabel(len(file.Matches)) }</span>
		</div>
		for _, match := range file.Matches {
			<div class="codeline">
				<div class="codeline__ln" aria-label={ "Line " + strconv.Itoa(match.LineNumber) }>{ strconv.Itoa(match.LineNumber) }</div>
				<div class="codeline__src">{ match.Line }</div>
				<button
					type="button"
					class="codeline__ctx"
					hx-get={ contextURL(data.SearchID, data.SearchDataSource, data.Result.Slug, file.Filename, match.LineNumber) }
					hx-target="#context-modal"
					hx-swap="innerHTML"
					title="Show context"
				>
					@icon.External(12)
					<span>± Context</span>
				</button>
			</div>
		}
	}
}
