package partial

import (
	"veloria/internal/ui"
	"veloria/internal/ui/badge"
)

templ AdminVisibilityToggle(data ui.VisibilityToggleData) {
	<div style="display:inline-flex; align-items:center; gap: var(--s-2);">
		@badge.Visibility(data.Private)
		if data.Private {
			<button
				hx-post={ "/admin/search/" + data.SearchID + "/visibility" }
				hx-target="closest div"
				hx-swap="outerHTML"
				class="btn btn--ghost"
			>Make Public</button>
		} else {
			<button
				hx-post={ "/admin/search/" + data.SearchID + "/visibility" }
				hx-target="closest div"
				hx-swap="outerHTML"
				class="btn btn--danger"
			>Make Private</button>
		}
	</div>
}
