package partial

import (
	"fmt"
	"strconv"

	"veloria/internal/ui"
	"veloria/internal/ui/badge"
)

func datasourceItemsURL(dsType string, page int, search string) string {
	url := "/data-sources/" + dsType + "/items?page=" + strconv.Itoa(page)
	if search != "" {
		url += "&search=" + search
	}
	return url
}

templ DataSourceItems(data ui.DataSourceItemsData) {
	if len(data.Items) > 0 {
		<div>
			for _, item := range data.Items {
				<a href={ templ.SafeURL("/data-sources/" + data.DataSource + "/" + item.Slug) } style="display:flex; align-items:center; justify-content:space-between; gap: var(--s-4); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--border); text-decoration:none; color:inherit; transition: background var(--dur-fast) var(--ease);" class="datasource-item">
					<div>
						<h3 style="color: var(--text); font-weight:600;">{ item.Name }</h3>
						<p style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-faint);">{ item.Slug }</p>
					</div>
					<div style="display:flex; align-items:center; gap: var(--s-4); flex-wrap: wrap;">
						if item.FileCount > 0 {
							<span style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-faint);">{ ui.FormatCompact(item.FileCount) } files</span>
						}
						if item.TotalSize > 0 {
							<span style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-faint);">{ ui.FormatBytes(item.TotalSize) }</span>
						}
						<span style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-dim);">v{ item.Version }</span>
						@badge.Indexed(item.Indexed)
					</div>
				</a>
			}
		</div>
		if data.TotalPages > 1 {
			<div style="display:flex; align-items:center; justify-content:space-between; padding: var(--s-3) var(--s-5); border-top: 1px solid var(--border);">
				<p class="eyebrow" style="color: var(--text-dim);">{ fmt.Sprintf("Page %d of %d", data.Page, data.TotalPages) }</p>
				<div style="display:flex; gap: var(--s-2);">
					if data.Page > 1 {
						<button
							hx-get={ datasourceItemsURL(data.DataSource, data.Page-1, data.Search) }
							hx-target="#datasource-items"
							hx-swap="innerHTML"
							class="btn"
						>
							Previous
						</button>
					}
					if data.Page < data.TotalPages {
						<button
							hx-get={ datasourceItemsURL(data.DataSource, data.Page+1, data.Search) }
							hx-target="#datasource-items"
							hx-swap="innerHTML"
							class="btn"
						>
							Next
						</button>
					}
				</div>
			</div>
		}
	} else {
		<div style="padding: var(--s-10) var(--s-5); text-align:center; color: var(--text-faint);">
			if data.Search != "" {
				<p>No items matching "{ data.Search }".</p>
			} else {
				<p>No items found in this data source.</p>
			}
		</div>
	}
}
