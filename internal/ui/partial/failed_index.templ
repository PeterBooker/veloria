package partial

import (
	"fmt"
	"strconv"

	"veloria/internal/ui"
)

func failedIndexURL(dsType string, page int) string {
	return "/data-sources/" + dsType + "/failed-indexing?page=" + strconv.Itoa(page)
}

templ FailedIndex(data ui.FailedIndexData) {
	if len(data.Events) > 0 {
		<div style="overflow-x:auto;">
			<table class="table" style="border:0; border-radius:0; box-shadow:none;">
				<thead>
					<tr>
						<th scope="col">Slug</th>
						<th scope="col">Error</th>
						<th scope="col" style="white-space:nowrap;">Time</th>
					</tr>
				</thead>
				<tbody>
					for _, ev := range data.Events {
						<tr>
							<td>
								<a href={ templ.SafeURL("/data-sources/" + data.DataSource + "/" + ev.Slug) } style="color: var(--accent-text); font-family: var(--font-mono); font-size: var(--fs-micro); text-decoration:none;">{ ev.Slug }</a>
							</td>
							<td style="max-width: 480px;">
								<span style="color: var(--text-faint); display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title={ ev.ErrorMessage }>{ ev.ErrorMessage }</span>
							</td>
							<td style="white-space:nowrap; color: var(--text-faint); font-family: var(--font-mono); font-size: var(--fs-micro);">{ ui.TimeAgo(ev.CreatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if data.TotalPages > 1 {
			<div style="display:flex; align-items:center; justify-content:space-between; padding: var(--s-3) var(--s-5); border-top: 1px solid var(--border);">
				<p class="eyebrow" style="color: var(--text-dim);">{ fmt.Sprintf("Page %d of %d (%d total)", data.Page, data.TotalPages, data.TotalCount) }</p>
				<div style="display:flex; gap: var(--s-2);">
					if data.Page > 1 {
						<button
							hx-get={ failedIndexURL(data.DataSource, data.Page-1) }
							hx-target="#failed-indexing"
							hx-swap="innerHTML"
							class="btn"
						>
							Previous
						</button>
					}
					if data.Page < data.TotalPages {
						<button
							hx-get={ failedIndexURL(data.DataSource, data.Page+1) }
							hx-target="#failed-indexing"
							hx-swap="innerHTML"
							class="btn"
						>
							Next
						</button>
					}
				</div>
			</div>
		}
	} else {
		<div style="padding: var(--s-8) var(--s-5); text-align:center; color: var(--text-faint);">
			<p>No failed indexing attempts.</p>
		</div>
	}
}
