package partial

import (
	"fmt"
	"strconv"

	"veloria/internal/ui"
	"veloria/internal/ui/badge"
)

func searchExtensionsURL(searchID string, page int, search string) string {
	url := "/search/" + searchID + "/extensions?page=" + strconv.Itoa(page)
	if search != "" {
		url += "&search=" + search
	}
	return url
}

func extDetailAttrs(searchID, slug string) templ.Attributes {
	jsCall := "toggleExtDetail(this, '/search/" + searchID + "/extension/" + slug + "', 'ext-detail-" + slug + "')"
	return templ.Attributes{
		"aria-expanded": "false",
		"aria-controls": "ext-detail-" + slug,
		"onclick":       jsCall,
		"onkeydown":     "if(event.key==='Enter'||event.key===' '){event.preventDefault();" + jsCall + "}",
	}
}

templ SearchExtensions(data ui.SearchExtensionsData) {
	if len(data.Extensions) > 0 {
		<div id="result-list" aria-label="Search results">
			for _, ext := range data.Extensions {
				<article class="result">
					<button
						type="button"
						class="result__head"
						{ extDetailAttrs(data.SearchID, ext.Slug)... }
					>
						<div class="result__info">
							<div class="result__title">{ ext.Name }</div>
							<div class="result__slug">{ ext.Slug }/{ ext.Version }</div>
						</div>
						@badge.DataSourceType(data.SearchDataSource)
						if ext.ActiveInstalls > 0 {
							<span class="result__installs">{ ui.FormatInstalls(ext.ActiveInstalls) } installs</span>
						} else {
							<span class="result__installs">—</span>
						}
						<span class="result__matches">{ ui.FormatNumber(ext.TotalMatches) } { matchLabel(ext.TotalMatches) }</span>
						<span class="result__chev" aria-hidden="true">›</span>
					</button>
					<div class="result__body" hidden>
						<div id={ "ext-detail-" + ext.Slug }>
							<div class="codeline" role="status" aria-label="Loading">
								<div class="codeline__ln">…</div>
								<div class="codeline__src" style="color: var(--text-faint);">Loading matches…</div>
								<span></span>
							</div>
						</div>
					</div>
				</article>
			}
		</div>
		if data.TotalPages > 1 {
			<div style="margin-top: var(--s-5); display:flex; align-items:center; justify-content:space-between; gap: var(--s-3); flex-wrap: wrap;">
				<p class="eyebrow" style="color: var(--text-dim);">{ fmt.Sprintf("Page %d of %d", data.Page, data.TotalPages) }</p>
				<div style="display:flex; gap: var(--s-2);">
					if data.Page > 1 {
						<button
							hx-get={ searchExtensionsURL(data.SearchID, data.Page-1, data.Search) }
							hx-target="#search-extensions"
							hx-swap="innerHTML"
							class="btn"
						>
							Previous
						</button>
					}
					if data.Page < data.TotalPages {
						<button
							hx-get={ searchExtensionsURL(data.SearchID, data.Page+1, data.Search) }
							hx-target="#search-extensions"
							hx-swap="innerHTML"
							class="btn"
						>
							Next
						</button>
					}
				</div>
			</div>
		}
	} else {
		<div class="empty">
			<div class="empty__title" style="font-size: var(--fs-minor); font-weight: 500;">
				if data.Search != "" {
					No extensions matching "{ data.Search }".
				} else {
					No matching extensions found.
				}
			</div>
		</div>
	}
}

func matchLabel(n int) string {
	if n == 1 {
		return "match"
	}
	return "matches"
}
