package partial

import (
	"strconv"

	"veloria/internal/ui"
	"veloria/internal/ui/icon"
)

templ SearchContext(data ui.SearchContextData) {
	<div role="dialog" aria-modal="true" aria-label="Match context" style="position:fixed; inset:0; z-index:80; display:flex; align-items:center; justify-content:center; padding: var(--s-5); background: color-mix(in srgb, var(--bg) 75%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
		<button
			type="button"
			aria-label="Close dialog"
			onclick="document.getElementById('context-modal').innerHTML = ''"
			style="position:absolute; inset:0; background:transparent; border:0; cursor:pointer;"
		></button>
		<div class="card card--elevated" style="position:relative; z-index:1; width:100%; max-width: 720px; overflow:hidden;">
			<div style="display:flex; align-items:center; justify-content:space-between; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border); background: var(--surface-2);">
				<div style="min-width:0;">
					<div class="eyebrow">Match Context</div>
					<div style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text); margin-top: 2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title={ data.Filename }>{ data.Filename }</div>
				</div>
				<button
					type="button"
					class="btn btn--icon"
					onclick="document.getElementById('context-modal').innerHTML = ''"
					aria-label="Close"
				>
					@icon.Close(16)
				</button>
			</div>
			<div style="background: var(--code-bg);">
				if data.Error != "" {
					<div class="alert alert--error" style="margin: var(--s-4);">
						<span>{ data.Error }</span>
					</div>
				} else {
					for _, line := range data.Lines {
						if line.IsMatch {
							<div class="codeline" style="background: var(--accent-2-soft);">
								<div class="codeline__ln" style="color: var(--accent-2-text); border-right-color: color-mix(in srgb, var(--accent-2) 45%, transparent);">{ strconv.Itoa(line.Number) }</div>
								<div class="codeline__src" style="color: var(--match-text);">{ line.Text }</div>
								<span></span>
							</div>
						} else {
							<div class="codeline">
								<div class="codeline__ln">{ strconv.Itoa(line.Number) }</div>
								<div class="codeline__src">{ line.Text }</div>
								<span></span>
							</div>
						}
					}
				}
			</div>
		</div>
	</div>
}
