package nav

import "strings"

// NavItem defines a navigation link.
type NavItem struct {
	Href      string
	Label     string
	Active    bool
	AdminOnly bool
	AuthOnly  bool
}

// BuildNavItems returns the standard navigation items with active state set.
func BuildNavItems(currentPath string, loggedIn, isAdmin bool) []NavItem {
	items := []NavItem{
		{Href: "/searches", Label: "Searches", Active: currentPath == "/searches" || strings.HasPrefix(currentPath, "/search")},
		{Href: "/data-sources", Label: "Data Sources", Active: strings.HasPrefix(currentPath, "/data-sources")},
		{Href: "/docs", Label: "Docs", Active: strings.HasPrefix(currentPath, "/docs")},
		{Href: "/about", Label: "About", Active: currentPath == "/about"},
		{Href: "/admin/reports", Label: "Reports", Active: strings.HasPrefix(currentPath, "/admin/reports"), AdminOnly: true},
	}

	var result []NavItem
	for _, item := range items {
		if item.AdminOnly && !isAdmin {
			continue
		}
		if item.AuthOnly && !loggedIn {
			continue
		}
		result = append(result, item)
	}
	return result
}

templ NavLink(item NavItem) {
	if item.Active {
		<a href={ templ.SafeURL(item.Href) } class="nav__link" aria-current="page">{ item.Label }</a>
	} else {
		<a href={ templ.SafeURL(item.Href) } class="nav__link">{ item.Label }</a>
	}
}

// DesktopNavLink is kept as a shim for any external callers.
templ DesktopNavLink(item NavItem) {
	@NavLink(item)
}
