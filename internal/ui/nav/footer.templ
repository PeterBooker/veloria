package nav

import (
	"time"

	"veloria/internal/ui"
	"veloria/internal/ui/icon"
)

templ Footer(version string, requestStart time.Time) {
	<footer class="site-footer">
		<nav class="site-footer__inner" aria-label="Footer links">
			<a href="https://github.com/PeterBooker/veloria" target="_blank" rel="noopener noreferrer" class="site-footer__link">
				@icon.GitHub(14)
				GitHub
			</a>
			if version == "dev" {
				<span>Version: dev</span>
			} else {
				<a href={ templ.SafeURL("https://github.com/PeterBooker/veloria/releases/tag/" + version) } target="_blank" rel="noopener noreferrer" class="site-footer__link">Version: { version }</a>
			}
			<a href="/privacy" class="site-footer__link">Privacy</a>
			<a href="/terms" class="site-footer__link">Terms</a>
			<span>© 2026 Veloria</span>
			if !requestStart.IsZero() {
				<span>Request: { ui.Elapsed(requestStart) }</span>
			}
		</nav>
	</footer>
}
