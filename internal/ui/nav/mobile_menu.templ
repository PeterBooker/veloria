package nav

import (
	"veloria/internal/ui/icon"
	"veloria/internal/user"
)

templ MobileHeader(currentPath string, u *user.User) {
	<header class="nav nav--mobile">
		<div class="nav__inner">
			<a href="/" class="logo" aria-label="Veloria home">
				@icon.Logo(22)
				<span>Veloria</span>
			</a>
			<div class="nav__toggle" style="display:flex;align-items:center;gap:var(--s-2);">
				@ThemeToggleButton()
				<button
					type="button"
					class="btn btn--icon"
					id="mobile-menu-button"
					onclick="toggleMobileMenu()"
					aria-label="Open navigation menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
					hx-boost="false"
				>
					@icon.Menu(18)
				</button>
			</div>
		</div>
	</header>
	<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu" hidden hx-boost="false">
		<div class="mobile-menu__scrim" onclick="toggleMobileMenu()"></div>
		<nav class="mobile-menu__panel">
			<div class="mobile-menu__header">
				<a href="/" class="logo" onclick="toggleMobileMenu()">
					@icon.Logo(22)
					<span>Veloria</span>
				</a>
				<button type="button" class="btn btn--icon" onclick="toggleMobileMenu()" aria-label="Close menu">
					@icon.Close(18)
				</button>
			</div>
			@mobileNavLink("/", "Home", currentPath == "/")
			for _, item := range BuildNavItems(currentPath, u != nil, u != nil && u.IsAdmin) {
				@mobileNavLink(item.Href, item.Label, item.Active)
			}
			<div class="mobile-menu__footer">
				if u != nil {
					@mobileUserSection(u)
				} else {
					<a href="/login" onclick="toggleMobileMenu()" class="mobile-menu__link">Log in</a>
				}
			</div>
		</nav>
	</div>
}

templ mobileNavLink(href, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } onclick="toggleMobileMenu()" class="mobile-menu__link" aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } onclick="toggleMobileMenu()" class="mobile-menu__link">{ label }</a>
	}
}

templ mobileUserSection(u *user.User) {
	<div style="display:flex;align-items:center;gap:var(--s-3);padding:var(--s-2) var(--s-3);color:var(--text-dim);">
		if u.AvatarURL != nil && *u.AvatarURL != "" {
			<img src={ *u.AvatarURL } alt="" class="nav__avatar"/>
		} else {
			<span class="nav__avatar" aria-hidden="true">{ string(u.Name[0:1]) }</span>
		}
		<span>{ u.Name }</span>
	</div>
	<a href="/logout" hx-boost="false" onclick="toggleMobileMenu()" class="mobile-menu__link">Sign out</a>
}
