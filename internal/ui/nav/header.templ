package nav

import (
	"veloria/internal/ui/icon"
	"veloria/internal/user"
)

templ Header(currentPath string, u *user.User) {
	<header class="nav nav--desktop">
		<div class="nav__inner">
			<a href="/" class="logo" aria-label="Veloria home">
				@icon.Logo(22)
				<span>Veloria</span>
			</a>
			<nav class="nav__links" aria-label="Primary">
				for _, item := range BuildNavItems(currentPath, u != nil, u != nil && u.IsAdmin) {
					@NavLink(item)
				}
			</nav>
			<div class="nav__right">
				@ThemeToggleButton()
				if u != nil {
					@userSection(u)
				} else {
					<a href="/login" class="btn btn--ghost">Login</a>
				}
			</div>
		</div>
	</header>
}

templ ThemeToggleButton() {
	<button
		type="button"
		class="btn btn--icon"
		data-theme-toggle
		aria-label="Toggle light or dark theme"
		aria-pressed="false"
	>
		@icon.Moon(16)
	</button>
}

templ userSection(u *user.User) {
	<div class="nav__user">
		if u.AvatarURL != nil && *u.AvatarURL != "" {
			<img src={ *u.AvatarURL } alt="" class="nav__avatar"/>
		} else {
			<span class="nav__avatar" aria-hidden="true">{ string(u.Name[0:1]) }</span>
		}
		<span>{ u.Name }</span>
		<a href="/logout" hx-boost="false" class="btn btn--ghost">Sign out</a>
	</div>
}
