package shared

import (
	"fmt"
	"strconv"

	"veloria/internal/ui/icon"
)

templ LinkPagination(baseURL string, page, totalPages int) {
	if totalPages > 1 {
		<div style="display:flex; align-items:center; justify-content:center; gap: var(--s-4); margin-top: var(--s-6);">
			if page > 1 {
				<a href={ templ.SafeURL(baseURL + "?page=" + strconv.Itoa(page-1)) } class="btn">
					@icon.ChevronLeft(14)
					Previous
				</a>
			} else {
				<span class="btn" aria-disabled="true" style="opacity:0.5; cursor:default;">
					@icon.ChevronLeft(14)
					Previous
				</span>
			}
			<span class="eyebrow" style="color: var(--text-dim);">{ fmt.Sprintf("Page %d of %d", page, totalPages) }</span>
			if page < totalPages {
				<a href={ templ.SafeURL(baseURL + "?page=" + strconv.Itoa(page+1)) } class="btn">
					Next
					@icon.ChevronRight(14)
				</a>
			} else {
				<span class="btn" aria-disabled="true" style="opacity:0.5; cursor:default;">
					Next
					@icon.ChevronRight(14)
				</span>
			}
		</div>
	}
}
