package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/layout"
)

templ About(pd ui.PageData) {
	@layout.Base(pd) {
		<section class="view">
			<div style="margin-bottom: var(--s-6);">
				<span class="eyebrow">About</span>
				<h1 style="font-size: var(--fs-h1); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-3) 0 var(--s-2); color: var(--text);">About Veloria</h1>
				<p style="color: var(--text-dim); font-size: var(--fs-lead);">WordPress code search, reimagined</p>
			</div>
			<div class="prose">
				<p>
					Veloria is a fast, full-text code search engine for the WordPress ecosystem. It indexes the source code of every plugin, theme and core version published on wordpress.org, letting developers search across the entire directory in seconds. Veloria is the successor to <a href="https://wpdirectory.net/">wpdirectory.net</a>, rebuilt from the ground up with a modern stack and a focus on reliability.
				</p>
				<h2>Technology</h2>
				<p>
					Under the hood, Veloria relies on Google's <a href="https://github.com/google/codesearch">codesearch</a> library, which uses trigram indexing to perform regular-expression searches over large codebases at speed, by only searching files that can potentially contain a match.
				</p>
				<p>
					Plugin and theme metadata is sourced from <a href="https://github.com/fairpm/aspirecloud">AspireCloud</a>, FAIR's community-driven mirror of the wordpress.org API. AspireCloud provides a reliable, independent gateway to the WordPress directory data that Veloria depends on.
				</p>
				<h2>Sponsorship</h2>
				<p>
					Veloria is an open-source project maintained in spare time. If you find it useful and would like to help cover hosting and development costs, sponsorship is welcome via <a href="https://github.com/PeterBooker/veloria">GitHub Sponsors</a>. Every contribution, no matter how small, helps keep the service running.
				</p>
				<h2>Licenses</h2>
				<p>
					The Veloria source code is released under the <a href="https://github.com/PeterBooker/veloria/blob/main/LICENSE">MIT License</a>. Third-party libraries used by the project retain their own respective licenses. WordPress plugin and theme source code displayed in search results remains subject to the license chosen by each individual author.
				</p>
				<h2>Privacy &amp; Terms</h2>
				<p>
					Veloria collects the minimum data necessary to operate. No analytics trackers or advertising scripts are loaded. For full details, see our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.
				</p>
			</div>
		</section>
	}
}
