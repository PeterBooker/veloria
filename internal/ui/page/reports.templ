package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/badge"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
	"veloria/internal/ui/shared"
)

templ Reports(data ui.ReportsPageData) {
	@layout.Base(data.PageData) {
		<section class="view">
			<div style="margin-bottom: var(--s-5);">
				<span class="eyebrow">Admin</span>
				<h1 style="font-size: var(--fs-h2); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-2) 0 var(--s-1); color: var(--text);">Reported Searches</h1>
				<p style="color: var(--text-dim); font-size: var(--fs-minor);">Review and moderate user-reported searches.</p>
			</div>
			if len(data.Reports) > 0 {
				<div class="card" style="overflow:hidden;">
					<table class="table" style="border:0; border-radius:0; box-shadow:none;">
						<thead>
							<tr>
								<th scope="col">Pattern</th>
								<th scope="col">Data Source</th>
								<th scope="col">Reporter</th>
								<th scope="col">Reason</th>
								<th scope="col">Reported</th>
								<th scope="col">Visibility</th>
								<th scope="col">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, report := range data.Reports {
								<tr>
									<td>
										<a href={ templ.SafeURL("/search/" + report.SearchID) } style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--accent-text); background: var(--code-bg); padding: 2px 6px; border: 1px solid var(--border); border-radius: var(--r-xs); text-decoration:none;">{ report.SearchTerm }</a>
									</td>
									<td style="text-transform: capitalize; color: var(--text-dim);">{ report.SearchDataSource }</td>
									<td style="color: var(--text-dim);">{ report.ReporterName }</td>
									<td>
										if report.Reason != "" {
											<span style="color: var(--text-dim);">{ report.Reason }</span>
										} else {
											<span style="color: var(--text-faint);">—</span>
										}
									</td>
									<td style="color: var(--text-faint); font-family: var(--font-mono); font-size: var(--fs-micro);">{ report.ReportedAt }</td>
									<td>
										<div id={ "visibility-" + report.ReportID } style="display:flex; align-items:center; gap: var(--s-2);">
											@badge.Visibility(report.SearchPrivate)
											if report.SearchPrivate {
												<button
													hx-post={ "/admin/search/" + report.SearchID + "/visibility" }
													hx-target={ "#visibility-" + report.ReportID }
													hx-swap="innerHTML"
													class="btn btn--ghost"
												>
													Make Public
												</button>
											} else {
												<button
													hx-post={ "/admin/search/" + report.SearchID + "/visibility" }
													hx-target={ "#visibility-" + report.ReportID }
													hx-swap="innerHTML"
													class="btn btn--danger"
												>
													Make Private
												</button>
											}
										</div>
									</td>
									<td>
										<div id={ "actions-" + report.ReportID } style="display:flex; align-items:center; gap: var(--s-2);">
											<button
												hx-post={ "/admin/reports/" + report.ReportID + "/resolve" }
												hx-target={ "#actions-" + report.ReportID }
												hx-swap="innerHTML"
												class="btn"
											>
												@icon.Check(12)
												Resolve
											</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@shared.LinkPagination("/admin/reports", data.Page, data.TotalPages)
			} else {
				<div class="empty">
					<div class="empty__icon">
						<svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
					<div class="empty__title">No pending reports</div>
					<p class="empty__body">All reported searches have been resolved.</p>
				</div>
			}
		</section>
	}
}
