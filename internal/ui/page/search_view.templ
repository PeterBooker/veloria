package page

import (
	searchmodel "veloria/internal/search/model"
	"veloria/internal/ui"
	"veloria/internal/ui/badge"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
	"veloria/internal/ui/shared"
)

templ SearchView(data ui.SearchViewData) {
	@layout.Base(data.PageData) {
		<section class="view">
			if data.ModerationNotice != "" {
				@shared.InfoAlert(data.ModerationNotice)
			}
			<div class="results__meta">
				<span class="eyebrow">Search Result</span>
				<span class="eyebrow" style="color: var(--text-faint);">#{ data.Search.ID.String()[:8] }</span>
				<span class="spacer"></span>
				<a class="btn btn--ghost" href="/">
					@icon.ArrowLeft(14)
					Back to search
				</a>
			</div>
			<div class="results__pattern" aria-label="Search pattern">{ data.Search.Term }</div>
			<div class="results__tags" aria-label="Search metadata">
				@badge.Status(data.Search.Status)
				@badge.DataSourceType(data.Search.Repo)
				<span class="pill">{ data.Search.CreatedAt.Format("2006-01-02 15:04") }</span>
				if data.DurationMs > 0 {
					<span class="pill">{ ui.FormatDuration(data.DurationMs) }</span>
				}
				@badge.Visibility(data.Search.Private)
				if data.User != nil && data.User.IsAdmin {
					<div id={ "admin-visibility-" + data.Search.ID.String() } style="display:inline-flex;align-items:center;gap:var(--s-2);">
						if data.Search.Private {
							<button
								hx-post={ "/admin/search/" + data.Search.ID.String() + "/visibility" }
								hx-target={ "#admin-visibility-" + data.Search.ID.String() }
								hx-swap="innerHTML"
								class="btn btn--ghost"
							>
								Make Public
							</button>
						} else {
							<button
								hx-post={ "/admin/search/" + data.Search.ID.String() + "/visibility" }
								hx-target={ "#admin-visibility-" + data.Search.ID.String() }
								hx-swap="innerHTML"
								class="btn btn--danger"
							>
								Make Private
							</button>
						}
					</div>
				}
				if data.User != nil && !data.Search.Private {
					<div id={ "report-btn-" + data.Search.ID.String() }>
						<button
							hx-post={ "/search/" + data.Search.ID.String() + "/report" }
							hx-target={ "#report-btn-" + data.Search.ID.String() }
							hx-swap="innerHTML"
							class="btn btn--ghost"
						>
							@icon.Flag(14)
							Report
						</button>
					</div>
				}
			</div>
			if data.Search.Status == searchmodel.StatusQueued || data.Search.Status == searchmodel.StatusProcessing {
				<div
					id="search-content"
					hx-get={ "/search/" + data.Search.ID.String() }
					hx-trigger="every 2s"
					hx-select="#search-content"
					hx-swap="outerHTML"
				>
					@searchContentInner(data)
				</div>
			} else {
				<div id="search-content">
					@searchContentInner(data)
				</div>
			}
		</section>
	}
}

templ searchContentInner(data ui.SearchViewData) {
	if data.Error != "" {
		@shared.ErrorAlert(data.Error)
	}
	if data.TotalExtensions > 0 {
		if data.MatchCapReached {
			@shared.InfoAlert("This search hit the maximum cap of 100,000 matches and was terminated before finishing. Some extensions may not have been searched.")
		}
		<div class="toolbar">
			<div class="toolbar__count">
				<strong>{ ui.FormatNumber(data.TotalMatches) }</strong> matches across <strong>{ ui.FormatNumber(data.TotalExtensions) }</strong> extensions
			</div>
			<span class="spacer"></span>
			<label class="sr-only" for="filter-input">Filter extensions</label>
			<input
				class="field"
				id="filter-input"
				type="search"
				name="search"
				placeholder="filter extensions…"
				hx-get={ "/search/" + data.Search.ID.String() + "/extensions" }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#search-extensions"
				hx-swap="innerHTML"
				hx-include="this"
			/>
			<a
				class="btn"
				href={ templ.SafeURL("/search/" + data.Search.ID.String() + "/export") }
				hx-boost="false"
			>
				@icon.Download(14)
				Export CSV
			</a>
		</div>
		<div
			id="search-extensions"
			hx-get={ "/search/" + data.Search.ID.String() + "/extensions" }
			hx-trigger="load"
			hx-swap="innerHTML"
			aria-live="polite"
		>
			<div class="empty" role="status" aria-label="Loading">
				<div class="empty__icon">
					@icon.Spinner(24)
				</div>
				<div class="empty__title" style="font-size: var(--fs-minor); font-weight: 500;">Loading extensions…</div>
			</div>
		</div>
		@toggleExtDetailScript()
	} else if data.Search.Status == searchmodel.StatusCompleted {
		<div class="empty">
			<div class="empty__icon">
				<svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
					<path d="M8 11h6"></path>
				</svg>
			</div>
			<div class="empty__title">No matches found</div>
			<p class="empty__body">Try a different regex pattern or data source.</p>
		</div>
	} else if data.Search.Status == searchmodel.StatusFailed {
		<div class="empty">
			<div class="empty__icon" style="color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, transparent); border-color: color-mix(in srgb, var(--danger) 40%, transparent);">
				@icon.Close(28)
			</div>
			<div class="empty__title">Search failed</div>
			<p class="empty__body">This search could not be completed. It may have timed out or encountered an unexpected error.</p>
			<div style="margin-top: var(--s-5);">
				<a href="/" class="btn">Try a new search</a>
			</div>
		</div>
	} else {
		<div class="empty">
			<div class="empty__icon">
				@icon.Spinner(28)
			</div>
			<div class="empty__title">Search in progress</div>
			if data.ProgressTotal > 0 {
				<p class="empty__body">
					Searched <strong style="color: var(--text); font-family: var(--font-mono);">{ ui.FormatNumber(data.ProgressSearched) }</strong> of
					<strong style="color: var(--accent-text); font-family: var(--font-mono);">{ ui.FormatNumber(data.ProgressTotal) }</strong> extensions
				</p>
				<div style="max-width: 360px; margin: var(--s-5) auto 0;">
					@shared.NeonProgress(ui.Percentage(data.ProgressSearched, data.ProgressTotal))
				</div>
			} else {
				<p class="empty__body">Results will appear automatically when the search completes.</p>
			}
		</div>
	}
}

templ toggleExtDetailScript() {
	<script>
	function toggleExtDetail(header, url, targetId) {
		var card = header.closest('.result');
		var detail = header.nextElementSibling;
		if (!detail) return;
		var isOpen = !detail.hasAttribute('hidden');

		if (isOpen) {
			detail.setAttribute('hidden', '');
			header.setAttribute('aria-expanded', 'false');
			if (card) card.classList.remove('is-expanded');
			return;
		}

		detail.removeAttribute('hidden');
		header.setAttribute('aria-expanded', 'true');
		if (card) card.classList.add('is-expanded');

		var target = document.getElementById(targetId);
		if (!target || target.dataset.loaded) return;
		target.dataset.loaded = '1';
		htmx.ajax('GET', url, {target: '#' + targetId, swap: 'innerHTML'});
	}
	</script>
}
