package page

import (
	"fmt"
	"strconv"

	"veloria/internal/ui"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
)

func datasourceTypeLabel(dsType string) string {
	switch dsType {
	case "plugins":
		return "Plugins"
	case "themes":
		return "Themes"
	case "cores":
		return "Core Versions"
	default:
		return dsType
	}
}

func barWidth(value, maxValue int64) string {
	if maxValue <= 0 {
		return "0%"
	}
	return fmt.Sprintf("%.1f%%", float64(value)/float64(maxValue)*100)
}

func barWidthInt(value, maxValue int) string {
	return barWidth(int64(value), int64(maxValue))
}

templ DataSource(data ui.DataSourceData) {
	@layout.Base(data.PageData) {
		<!-- Heading -->
		<div class="mb-6 pt-8 lg:pt-10">
			<nav class="text-sm text-text-faint mb-3">
				<a href="/data-sources" class="hover:text-accent-text hover:underline hover:underline-offset-2 transition-colors">Data Sources</a>
				<span class="mx-2">/</span>
				<span class="text-text-dim font-medium">{ data.DataSourceSummary.Title }</span>
			</nav>
			<div class="flex items-center gap-4">
				<div class="w-14 h-14 rounded-xl bg-white/[0.08] border border-white/10 flex items-center justify-center text-accent-text">
					@icon.DataSource(data.DataSourceSummary.Type, 28)
				</div>
				<div>
					<h1 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-text">{ data.DataSourceSummary.Title }</h1>
					<p class="text-sm text-text-dim">{ "WordPress " + data.DataSourceSummary.Type + " data source" }</p>
				</div>
			</div>
		</div>
		<!-- Index Status -->
		<div class="card p-6 mb-6">
			<div class="flex items-center justify-between mb-4">
				<h2 class="text-xl font-semibold text-text">Index Status</h2>
				<span class="text-sm text-text-faint">{ ui.FormatPercent(data.DataSourceSummary.IndexedPercent) + " complete" }</span>
			</div>
			<div class="grid grid-cols-3 gap-6 mb-4">
				<div>
					<p class="text-sm text-text-faint mb-1">Total Items</p>
					<p class="text-2xl font-bold text-text">{ ui.FormatNumber(data.DataSourceSummary.Total) }</p>
				</div>
				<div>
					<p class="text-sm text-text-faint mb-1">Indexed</p>
					<p class="text-2xl font-bold text-text">
						{ ui.FormatNumber(data.DataSourceSummary.Indexed) }
						<span class="text-sm font-normal text-text-faint">{ "(" + ui.FormatPercent(data.DataSourceSummary.IndexedPercent) + ")" }</span>
					</p>
				</div>
				<div>
					<p class="text-sm text-text-faint mb-1">Not Indexed</p>
					<p class="text-2xl font-bold text-text-faint">{ ui.FormatNumber(data.DataSourceSummary.Total - data.DataSourceSummary.Indexed) }</p>
				</div>
			</div>
			<div class="h-2 bg-white/[0.06] rounded-full overflow-hidden">
				if data.DataSourceSummary.Total > 0 {
					<div class="h-full rounded-full" style={ fmt.Sprintf("width: %.2f%%; background: var(--accent);", data.DataSourceSummary.IndexedPercent) }></div>
				} else {
					<div class="h-full bg-text-faint rounded-full"></div>
				}
			</div>
		</div>
		<!-- Charts Section -->
		if data.ActiveInstalls.JSON != "" || data.FileCount.JSON != "" || data.FileSize.JSON != "" {
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
				if data.ActiveInstalls.JSON != "" {
					<div class="card p-6">
						<div class="flex items-center justify-between mb-2">
							<h3 class="text-xl font-semibold text-text">Active Installs</h3>
							<span class="text-xs text-text-faint">{ "Max " + ui.FormatCompact(int(data.ActiveInstalls.Max)) }</span>
						</div>
						<div id="chart-active-installs" style="width:100%;height:200px;" data-chart={ data.ActiveInstalls.JSON }></div>
					</div>
				}
				if data.FileCount.JSON != "" || data.FileSize.JSON != "" {
					<div class="card p-6">
						<div class="flex items-center justify-between mb-2">
							<h3 class="text-xl font-semibold text-text">File Stats</h3>
						</div>
						<div id="chart-file-stats" style="width:100%;height:200px;" data-size-chart={ data.FileSize.JSON } data-count-chart={ data.FileCount.JSON }></div>
					</div>
				}
			</div>
			<script src={ "/static/js/echarts.min.js?v=" + data.Version }></script>
			@datasourceChartsInit()
		}
		<!-- Largest Extensions -->
		if len(data.LargestBySize) > 0 || len(data.LargestByFileCount) > 0 {
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
				if len(data.LargestBySize) > 0 {
					@largestBySize(data.DataSourceSummary.Type, data.LargestBySize)
				}
				if len(data.LargestByFileCount) > 0 {
					@largestByFileCount(data.DataSourceSummary.Type, data.LargestByFileCount)
				}
			</div>
		}
		<!-- Failed Indexing -->
		<div class="card overflow-hidden mb-6">
			<div class="px-6 py-4 border-b border-border">
				<h2 class="text-xl font-semibold text-text">Failed Indexing</h2>
			</div>
			<div
				id="failed-indexing"
				hx-get={ "/data-sources/" + data.DataSourceSummary.Type + "/failed-indexing" }
				hx-trigger="load"
				hx-swap="innerHTML"
			></div>
		</div>
		<!-- Items List -->
		<div class="card overflow-hidden">
			<div class="px-6 py-4 flex items-center justify-between gap-4 border-b border-border">
				<h2 class="text-xl font-semibold text-text flex-shrink-0">
					{ datasourceTypeLabel(data.DataSourceSummary.Type) }
				</h2>
				<div class="relative w-full max-w-xs">
					<div class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-faint pointer-events-none">
						@icon.Search(16)
					</div>
					<input
						type="search"
						name="search"
						placeholder="Search by name or slug..."
						aria-label="Search by name or slug"
						hx-get={ "/data-sources/" + data.DataSourceSummary.Type + "/items" }
						hx-trigger="input changed delay:300ms, search"
						hx-target="#datasource-items"
						hx-swap="innerHTML"
						hx-include="this"
						class="field w-full pl-9"
					/>
				</div>
			</div>
			<div
				id="datasource-items"
				hx-get={ "/data-sources/" + data.DataSourceSummary.Type + "/items" }
				hx-trigger="load"
				hx-swap="innerHTML"
			>
				<div class="px-6 py-12 flex items-center justify-center">
					<span class="text-accent">
						@icon.Spinner(20)
					</span>
					<span class="ml-2 text-sm text-text-faint">Loading...</span>
				</div>
			</div>
		</div>
	}
}

templ largestBySize(dsType string, extensions []ui.LargestExtension) {
	<div class="card overflow-hidden">
		<div class="px-6 py-4 border-b border-border">
			<h2 class="text-xl font-semibold text-text">Largest by Size</h2>
			<p class="text-sm text-text-faint">{ "Top " + strconv.Itoa(len(extensions)) + " " + datasourceTypeLabel(dsType) }</p>
		</div>
		<div class="p-6">
			<div class="space-y-3">
				for _, ext := range extensions {
					<a href={ templ.SafeURL("/data-sources/" + dsType + "/" + ext.Slug) } class="group block">
						<div class="flex items-center justify-between text-sm mb-1">
							<span class="text-text-dim group-hover:text-accent-text group-hover:underline font-medium truncate transition-colors duration-200">{ ext.Name }</span>
							<span class="text-text-faint ml-2 flex-shrink-0">{ ui.FormatBytes(ext.TotalSize) }</span>
						</div>
						<div class="h-1 bg-white/[0.04] rounded-full overflow-hidden">
							<div
								class="h-full rounded-full transition-all duration-300 opacity-50 group-hover:opacity-80"
								style={ "width: " + barWidth(ext.TotalSize, maxTotalSize(extensions)) + "; background: var(--accent);" }
							></div>
						</div>
					</a>
				}
			</div>
		</div>
	</div>
}

templ largestByFileCount(dsType string, extensions []ui.LargestExtension) {
	<div class="card overflow-hidden">
		<div class="px-6 py-4 border-b border-border">
			<h2 class="text-xl font-semibold text-text">Most Files</h2>
			<p class="text-sm text-text-faint">{ "Top " + strconv.Itoa(len(extensions)) + " " + datasourceTypeLabel(dsType) }</p>
		</div>
		<div class="p-6">
			<div class="space-y-3">
				for _, ext := range extensions {
					<a href={ templ.SafeURL("/data-sources/" + dsType + "/" + ext.Slug) } class="group block">
						<div class="flex items-center justify-between text-sm mb-1">
							<span class="text-text-dim group-hover:text-accent-text group-hover:underline font-medium truncate transition-colors duration-200">{ ext.Name }</span>
							<span class="text-text-faint ml-2 flex-shrink-0">{ ui.FormatNumber(ext.FileCount) + " files" }</span>
						</div>
						<div class="h-1 bg-white/[0.04] rounded-full overflow-hidden">
							<div
								class="h-full rounded-full transition-all duration-300 opacity-50 group-hover:opacity-80"
								style={ "width: " + barWidthInt(ext.FileCount, maxFileCount(extensions)) + "; background: var(--accent-2);" }
							></div>
						</div>
					</a>
				}
			</div>
		</div>
	</div>
}

func maxTotalSize(extensions []ui.LargestExtension) int64 {
	var m int64
	for _, ext := range extensions {
		if ext.TotalSize > m {
			m = ext.TotalSize
		}
	}
	return m
}

func maxFileCount(extensions []ui.LargestExtension) int {
	var m int
	for _, ext := range extensions {
		if ext.FileCount > m {
			m = ext.FileCount
		}
	}
	return m
}

templ datasourceChartsInit() {
	<script>
	(function() {
		function init() {
			var cs = getComputedStyle(document.documentElement);
			var brand500 = cs.getPropertyValue('--accent').trim() || '#22d3ee';
			var brand300 = cs.getPropertyValue('--accent-2').trim() || '#ec4899';
			var textFaint = cs.getPropertyValue('--text-faint').trim() || '#858599';
			var borderColor = cs.getPropertyValue('--border').trim() || 'rgba(255,255,255,0.06)';

			function fmtBytes(b) {
				if (b >= 1073741824) return (b/1073741824).toFixed(1)+' GB';
				if (b >= 1048576) return (b/1048576).toFixed(1)+' MB';
				if (b >= 1024) return (b/1024).toFixed(1)+' KB';
				return b+' B';
			}
			function fmtCompact(n) {
				if (n >= 1e9) return (n/1e9).toFixed(0)+'B';
				if (n >= 1e6) return (n/1e6).toFixed(0)+'M';
				if (n >= 1e3) return (n/1e3).toFixed(0)+'K';
				return n.toString();
			}

			var aiEl = document.getElementById('chart-active-installs');
			if (aiEl && aiEl.dataset.chart) {
				var data = JSON.parse(aiEl.dataset.chart);
				var chart = echarts.init(aiEl);
				chart.setOption({
					grid: { top: 10, right: 16, bottom: 24, left: 50 },
					xAxis: { type: 'category', show: false, data: data.map(function(_,i){return i;}) },
					yAxis: { type: 'value', axisLabel: { fontSize: 10, color: textFaint, formatter: function(v){return fmtCompact(v);} }, splitLine: { lineStyle: { color: borderColor } } },
					tooltip: { trigger: 'axis', formatter: function(p){ return 'Active installs: '+fmtCompact(p[0].value); } },
					series: [{
						type: 'line', data: data, showSymbol: false, smooth: true,
						lineStyle: { color: brand500, width: 2 },
						areaStyle: { color: 'rgba(34,211,238,0.08)' },
						itemStyle: { color: brand500 }
					}]
				});
				window.addEventListener('resize', function(){ chart.resize(); });
			}

			var fsEl = document.getElementById('chart-file-stats');
			if (fsEl) {
				var sizeData = fsEl.dataset.sizeChart ? JSON.parse(fsEl.dataset.sizeChart) : [];
				var countData = fsEl.dataset.countChart ? JSON.parse(fsEl.dataset.countChart) : [];
				if (sizeData.length || countData.length) {
					var chart = echarts.init(fsEl);
					var series = [];
					if (sizeData.length) {
						series.push({ name: 'Total size', type: 'line', data: sizeData, showSymbol: false, smooth: true, yAxisIndex: 0,
							lineStyle: { color: brand500, width: 2 }, itemStyle: { color: brand500 } });
					}
					if (countData.length) {
						series.push({ name: 'File count', type: 'line', data: countData, showSymbol: false, smooth: true, yAxisIndex: 1,
							lineStyle: { color: brand300, width: 2 }, itemStyle: { color: brand300 } });
					}
					chart.setOption({
						grid: { top: 10, right: 60, bottom: 24, left: 50 },
						xAxis: { type: 'category', show: false, data: (sizeData.length ? sizeData : countData).map(function(_,i){return i;}) },
						yAxis: [
							{ type: 'value', position: 'left', axisLabel: { fontSize: 10, color: textFaint, formatter: function(v){return fmtBytes(v);} }, splitLine: { lineStyle: { color: borderColor } } },
							{ type: 'value', position: 'right', axisLabel: { fontSize: 10, color: textFaint, formatter: function(v){return fmtCompact(v);} }, splitLine: { show: false } }
						],
						tooltip: { trigger: 'axis', formatter: function(p){ var s=''; for(var i=0;i<p.length;i++){s+=p[i].marker+' '+p[i].seriesName+': '+(p[i].seriesName==='Total size'?fmtBytes(p[i].value):fmtCompact(p[i].value))+'<br>';} return s; } },
						legend: { bottom: 0, itemWidth: 10, itemHeight: 10, textStyle: { fontSize: 10, color: textFaint } },
						series: series
					});
					window.addEventListener('resize', function(){ chart.resize(); });
				}
			}
		}

		if (typeof echarts !== 'undefined') {
			init();
		} else {
			var s = document.querySelector('script[src*="echarts"]');
			if (s) s.addEventListener('load', init);
		}
	})();
	</script>
}
