package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
)

templ Login(data ui.LoginData) {
	@layout.Base(data.PageData) {
		<section class="view">
			<div style="max-width: 440px; margin: 0 auto;">
				<div class="card card--elevated" style="padding: var(--s-8);">
					<div style="text-align:center; margin-bottom: var(--s-6);">
						<span class="eyebrow">Sign in</span>
						<h1 style="font-size: var(--fs-h2); font-weight:700; letter-spacing: var(--ls-tight); margin: var(--s-2) 0 var(--s-1); color: var(--text);">Welcome back</h1>
						<p style="color: var(--text-dim); font-size: var(--fs-minor);">Choose your preferred login method</p>
					</div>
					if data.Error != "" {
						<div class="alert alert--error" role="alert">
							<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="12" y1="8" x2="12" y2="12"></line>
								<line x1="12" y1="16" x2="12.01" y2="16"></line>
							</svg>
							<span>
								if data.Error == "auth_failed" {
									Authentication failed. Please try again.
								} else if data.Error == "user_failed" {
									Failed to process your account. Please try again.
								} else if data.Error == "session_failed" {
									Failed to create session. Please try again.
								} else {
									An error occurred. Please try again.
								}
							</span>
						</div>
					}
					if len(data.EnabledProviders) > 0 {
						<div style="display:flex; flex-direction:column; gap: var(--s-3);">
							for _, provider := range data.EnabledProviders {
								if provider == "github" {
									<a href="/auth/github" hx-boost="false" class="btn btn--lg" style="width:100%;">
										@icon.GitHub(18)
										Continue with GitHub
									</a>
								} else if provider == "gitlab" {
									<a href="/auth/gitlab" hx-boost="false" class="btn btn--lg" style="width:100%;">
										<svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m23.6 9.59-.01-.04-3.28-8.45a.87.87 0 0 0-.34-.39.89.89 0 0 0-1.01.1.87.87 0 0 0-.29.38l-2.22 6.73H7.55L5.33 1.19a.87.87 0 0 0-.29-.38.89.89 0 0 0-1.01-.1c-.15.09-.27.22-.34.39L.4 9.55l-.01.04a6.22 6.22 0 0 0 2.07 7.18l.01.01.02.01 5.16 3.85 2.55 1.93 1.56 1.17a1.05 1.05 0 0 0 1.26 0l1.56-1.17 2.55-1.93 5.18-3.86.01-.01a6.22 6.22 0 0 0 2.07-7.18Z"></path></svg>
										Continue with GitLab
									</a>
								} else if provider == "atlassian" {
									<a href="/auth/atlassian" hx-boost="false" class="btn btn--lg" style="width:100%;">
										<svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.77 13.48c-.2-.26-.5-.26-.7.04L.53 22.56c-.2.32-.08.64.28.64h7.7c.2 0 .4-.12.52-.36 1.18-2.64.64-6.88-2.26-9.36zm3.8-9.76c-2.18 3.56-2.06 7.84.38 11.08l4.04 5.52c.16.24.36.36.58.36h7.7c.36 0 .52-.32.3-.64L10.93 3.72c-.2-.24-.52-.24-.66 0z"></path></svg>
										Continue with Atlassian
									</a>
								}
							}
						</div>
					} else {
						<div style="text-align:center; color: var(--text-dim); padding: var(--s-4) 0;">
							<p>No authentication providers configured.</p>
							<p style="font-size: var(--fs-micro); margin-top: var(--s-2);">Please configure OAuth providers in the environment.</p>
						</div>
					}
					<p style="text-align:center; margin-top: var(--s-5); font-size: var(--fs-micro); color: var(--text-faint);">
						By signing in, you agree to our <a href="/terms" style="color: var(--text-dim); text-decoration: underline; text-underline-offset: 3px;">Terms of Service</a>.
					</p>
				</div>
			</div>
		</section>
	}
}
