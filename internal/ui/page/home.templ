package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
)

templ Home(data ui.HomeData) {
	@layout.Base(data.PageData) {
		<section class="view">
			<div class="page page--narrow" style="padding: 0;">
				if !data.SearchEnabled {
					<div class="alert alert--info" role="status">
						@icon.Info(18)
						<div>
							<strong>Search temporarily unavailable.</strong>
							if data.SearchDisabledReason != "" {
								{ " " + data.SearchDisabledReason }
							} else {
								{ " Please try again later." }
							}
						</div>
					</div>
				}
				<div class="hero">
					<div class="hero__logo" aria-hidden="true">
						@icon.Logo(56)
					</div>
					<h1 class="hero__title">Search WordPress Source Code</h1>
					<p class="hero__sub">Regex across every plugin, theme, and core version published on WordPress.org - in seconds.</p>
				</div>
				<form class="search" role="search" aria-label="Search WordPress source code" id="search-form" hx-post="/search">
					<div class="search__row">
						<div class="search__prompt" aria-hidden="true">/</div>
						<label for="regex-search" class="sr-only">Regex pattern</label>
						<input
							class="search__input"
							id="regex-search"
							name="term"
							type="text"
							spellcheck="false"
							autocomplete="off"
							autocapitalize="off"
							placeholder={ `apply_filters\(\s*['"]` }
							required
							disabled?={ !data.SearchEnabled }
							aria-describedby="searchHint"
						/>
						<button type="submit" class="search__submit" disabled?={ !data.SearchEnabled }>
							Search
							@icon.ArrowRight(14)
						</button>
					</div>
					<div class="search__options">
						<div class="seg" role="group" aria-label="Data source">
							<label>
								<input type="radio" name="repo" value="plugins" checked disabled?={ !data.SearchEnabled }/>
								Plugins
							</label>
							<label>
								<input type="radio" name="repo" value="themes" disabled?={ !data.SearchEnabled }/>
								Themes
							</label>
							<label>
								<input type="radio" name="repo" value="cores" disabled?={ !data.SearchEnabled }/>
								Core
							</label>
						</div>
						<label class="check">
							<input type="checkbox" name="case_sensitive" checked disabled?={ !data.SearchEnabled }/>
							case-sensitive
						</label>
						<label class="check">
							<input type="checkbox" name="exclude_minified" disabled?={ !data.SearchEnabled }/>
							exclude-minified
						</label>
						<label class="check" style="gap: var(--s-2);">
							<span>file-type</span>
							<select name="filetype" class="field" style="height: 28px; font-size: var(--fs-micro);" disabled?={ !data.SearchEnabled }>
								<option value="">all</option>
								<option value="php">.php</option>
								<option value="js">.js</option>
								<option value="css">.css</option>
								<option value="html">.html</option>
								<option value="json">.json</option>
								<option value="xml">.xml</option>
								<option value="txt">.txt</option>
								<option value="md">.md</option>
								<option value="sql">.sql</option>
							</select>
						</label>
						<span class="spacer"></span>
						<div class="seg" role="group" aria-label="Visibility">
							<label>
								<input type="radio" name="visibility" value="public" checked disabled?={ !data.SearchEnabled }/>
								Public
							</label>
							<label>
								<input type="radio" name="visibility" value="private" disabled?={ !data.SearchEnabled }/>
								Private
							</label>
						</div>
					</div>
					<span id="searchHint" class="sr-only">Uses Go RE2 regex syntax. Press enter to search.</span>
				</form>
				<section aria-labelledby="recents-heading" style="margin-top: var(--s-10);">
					<h2 class="section-label" id="recents-heading">Recent public searches</h2>
					if len(data.RecentSearches) > 0 {
						<div class="recents">
							for _, s := range data.RecentSearches {
								<a href={ templ.SafeURL("/search/" + s.Search.ID.String()) } class="recent">
									<span class="recent__pattern">{ s.Search.Term }</span>
									<span class="pill recent__source-pill">{ s.Search.Repo }</span>
									if s.MatchesKnown {
										if s.MatchCount == 0 {
											<span class="recent__matches recent__matches--zero">0</span>
										} else {
											<span class="recent__matches">{ ui.FormatNumber(s.MatchCount) }</span>
										}
									} else {
										<span class="recent__matches recent__matches--zero">—</span>
									}
									<span class="recent__date">{ ui.TimeAgo(s.Search.CreatedAt) }</span>
								</a>
							}
						</div>
					} else {
						<div class="recents" style="padding: var(--s-5); text-align: center; color: var(--text-faint); font-family: var(--font-mono); font-size: var(--fs-micro);">
							No public searches yet — be the first.
						</div>
					}
				</section>
				<section aria-labelledby="sources-heading" style="margin-top: var(--s-10);">
					<h2 class="section-label" id="sources-heading">Data sources</h2>
					<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--s-3);">
						<a href="/data-sources/plugins" class="card" style="padding: var(--s-5); text-decoration: none;">
							<h3 style="font-size: var(--fs-lead); font-weight: 600; color: var(--text); margin-bottom: var(--s-1);">Plugins</h3>
							<p style="color: var(--text-dim); font-size: var(--fs-minor);">WordPress plugins</p>
						</a>
						<a href="/data-sources/themes" class="card" style="padding: var(--s-5); text-decoration: none;">
							<h3 style="font-size: var(--fs-lead); font-weight: 600; color: var(--text); margin-bottom: var(--s-1);">Themes</h3>
							<p style="color: var(--text-dim); font-size: var(--fs-minor);">WordPress themes</p>
						</a>
						<a href="/data-sources/cores" class="card" style="padding: var(--s-5); text-decoration: none;">
							<h3 style="font-size: var(--fs-lead); font-weight: 600; color: var(--text); margin-bottom: var(--s-1);">Core</h3>
							<p style="color: var(--text-dim); font-size: var(--fs-minor);">WordPress core versions</p>
						</a>
					</div>
				</section>
			</div>
		</section>
		@homeKeyboardShortcut()
	}
}

templ homeKeyboardShortcut() {
	<script>
		document.addEventListener('keydown', function(e) {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				var input = document.getElementById('regex-search');
				if (input) { e.preventDefault(); input.focus(); }
			}
		});
	</script>
}
