package page

import (
	"fmt"

	"veloria/internal/ui"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
)

templ datasourceIcon(dsType string, size int) {
	switch dsType {
		case "plugins":
			@icon.Plugin(size)
		case "themes":
			@icon.Theme(size)
		default:
			@icon.Core(size)
	}
}

templ DataSources(data ui.DataSourcesData) {
	@layout.Base(data.PageData) {
		<section class="view">
			<div style="margin-bottom: var(--s-6);">
				<span class="eyebrow">Data sources</span>
				<h1 style="font-size: var(--fs-h2); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-2) 0 var(--s-1); color: var(--text);">Data Sources</h1>
				<p style="color: var(--text-dim); font-size: var(--fs-minor);">Browse indexed WordPress data sources</p>
			</div>
			<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--s-3);">
				for _, ds := range data.DataSourceSummaries {
					<a href={ templ.SafeURL("/data-sources/" + ds.Type) } class="card" style="padding: var(--s-5); text-decoration: none; display:block;">
						<div style="display:flex; align-items:center; gap: var(--s-3); margin-bottom: var(--s-4);">
							<div style="width:44px; height:44px; border-radius: var(--r-md); background: var(--surface-2); border: 1px solid var(--border); display:inline-flex; align-items:center; justify-content:center; color: var(--accent-text);">
								@datasourceIcon(ds.Type, 22)
							</div>
							<div>
								<h3 style="font-size: var(--fs-lead); font-weight: 600; color: var(--text); margin-bottom: 2px;">{ ds.Title }</h3>
								<p style="font-size: var(--fs-micro); color: var(--text-faint); text-transform: capitalize;">{ ds.Type } data source</p>
							</div>
						</div>
						<div style="display:flex; align-items:center; justify-content:space-between; font-size: var(--fs-micro); color: var(--text-dim); margin-bottom: var(--s-3); font-family: var(--font-mono);">
							<span><strong style="color: var(--text); font-weight:600;">{ ui.FormatNumber(ds.Total) }</strong> total</span>
							<span><strong style="color: var(--text); font-weight:600;">{ ui.FormatNumber(ds.Indexed) }</strong> indexed</span>
						</div>
						<div class="progress">
							if ds.Total > 0 {
								<div class="progress__bar" style={ fmt.Sprintf("width: %.2f%%", ds.IndexedPercent) }></div>
							} else {
								<div class="progress__bar" style="width: 0%;"></div>
							}
						</div>
						<p style="margin-top: var(--s-2); font-size: var(--fs-micro); color: var(--text-faint); text-align: right; font-family: var(--font-mono);">{ ui.FormatPercent(ds.IndexedPercent) } indexed</p>
					</a>
				}
			</div>
		</section>
	}
}
