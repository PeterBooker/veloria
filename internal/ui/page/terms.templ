package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/layout"
)

templ Terms(pd ui.PageData) {
	@layout.Base(pd) {
		<section class="view">
			<div style="margin-bottom: var(--s-6);">
				<span class="eyebrow">Legal</span>
				<h1 style="font-size: var(--fs-h1); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-3) 0 var(--s-2); color: var(--text);">Terms of Service</h1>
				<p style="color: var(--text-dim); font-size: var(--fs-minor);">Last updated: February 2026</p>
			</div>
			<div class="prose">
				<h2>Acceptance</h2>
				<p>By accessing or using Veloria you agree to these terms. If you do not agree, please do not use the service.</p>
				<h2>The Service</h2>
				<p>Veloria provides a code search engine for publicly available WordPress plugins, themes, and core releases. The service is provided "as is" without warranty of any kind. We may modify, suspend, or discontinue the service at any time without notice.</p>
				<h2>Intellectual Property</h2>
				<p>WordPress plugin and theme source code displayed in search results remains the property of its respective authors and is subject to the license chosen by each author. Veloria does not claim ownership of any third-party code.</p>
				<h2>Accounts</h2>
				<p>Signing in is optional. If you create an account via a third-party provider, you are responsible for maintaining the security of your account. We reserve the right to suspend accounts that violate these terms.</p>
				<h2>Limitation of Liability</h2>
				<p>Veloria and its maintainers shall not be liable for any indirect, incidental, or consequential damages arising from your use of the service.</p>
				<h2>Changes</h2>
				<p>We may update these terms from time to time. Continued use of the service after changes constitutes acceptance of the revised terms.</p>
				<h2>Contact</h2>
				<p>If you have questions about these terms, please open an issue on <a href="https://github.com/PeterBooker/veloria">GitHub</a>.</p>
			</div>
		</section>
	}
}
