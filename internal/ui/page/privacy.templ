package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/layout"
)

templ Privacy(pd ui.PageData) {
	@layout.Base(pd) {
		<section class="view">
			<div style="margin-bottom: var(--s-6);">
				<span class="eyebrow">Legal</span>
				<h1 style="font-size: var(--fs-h1); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-3) 0 var(--s-2); color: var(--text);">Privacy Policy</h1>
				<p style="color: var(--text-dim); font-size: var(--fs-minor);">Last updated: February 2026</p>
			</div>
			<div class="prose">
				<h2>What We Collect</h2>
				<p>Veloria collects the minimum data necessary to operate the service. When you perform a search, the query and results are stored so they can be shared and revisited. Searches marked as private are visible only to those with the URL. Searches made when logged in are linked to your user.</p>
				<h2>Authentication</h2>
				<p>If you sign in via a third-party provider (GitHub, GitLab, or Atlassian), Veloria stores your display name and avatar URL solely to personalise your session. We do not access your repositories, email address, or any other account data beyond what is needed for login.</p>
				<h2>Cookies</h2>
				<p>Veloria uses a single session cookie to keep you logged in. No analytics trackers, advertising scripts, or third-party cookies are loaded.</p>
				<h2>Server Logs</h2>
				<p>Standard server logs (IP address, request path, timestamp) are retained for a limited period for debugging and abuse prevention, then deleted.</p>
				<h2>Third Parties</h2>
				<p>Veloria does not sell, share, or transfer your data to third parties. The only external services involved are the OAuth providers you choose to sign in with.</p>
				<h2>Contact</h2>
				<p>If you have questions about this policy, please open an issue on <a href="https://github.com/PeterBooker/veloria">GitHub</a>.</p>
			</div>
		</section>
	}
}
