package page

import (
	"veloria/internal/ui"
	"veloria/internal/ui/badge"
	"veloria/internal/ui/icon"
	"veloria/internal/ui/layout"
	"veloria/internal/ui/shared"
)

templ Searches(data ui.SearchesData) {
	@layout.Base(data.PageData) {
		<section class="view">
			<div style="margin-bottom: var(--s-5);">
				if data.View == "own" {
					<span class="eyebrow">Searches</span>
					<h1 style="font-size: var(--fs-h2); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-2) 0 var(--s-1); color: var(--text);">My Searches</h1>
					<p style="color: var(--text-dim); font-size: var(--fs-minor);">Your personal search history, including private searches.</p>
				} else {
					<span class="eyebrow">Searches</span>
					<h1 style="font-size: var(--fs-h2); font-weight:700; letter-spacing: var(--ls-tight); line-height: var(--lh-tight); margin: var(--s-2) 0 var(--s-1); color: var(--text);">Recent Searches</h1>
					<p style="color: var(--text-dim); font-size: var(--fs-minor);">View and revisit previous code searches.</p>
				}
				if data.LoggedIn {
					<div class="seg" role="group" aria-label="View filter" style="margin-top: var(--s-4);">
						if data.View == "own" {
							<a href="/searches" class="seg-link" style="padding: 0 var(--s-3); height: 28px; display:inline-flex; align-items:center; font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-dim); text-decoration:none; border-radius: var(--r-xs);">All Searches</a>
							<a href="/searches/own" data-pressed="true" class="seg-link" style="padding: 0 var(--s-3); height: 28px; display:inline-flex; align-items:center; font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text); text-decoration:none; border-radius: var(--r-xs); background: var(--surface); font-weight:600; box-shadow: var(--shadow-sm);">My Searches</a>
						} else {
							<a href="/searches" data-pressed="true" class="seg-link" style="padding: 0 var(--s-3); height: 28px; display:inline-flex; align-items:center; font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text); text-decoration:none; border-radius: var(--r-xs); background: var(--surface); font-weight:600; box-shadow: var(--shadow-sm);">All Searches</a>
							<a href="/searches/own" class="seg-link" style="padding: 0 var(--s-3); height: 28px; display:inline-flex; align-items:center; font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text-dim); text-decoration:none; border-radius: var(--r-xs);">My Searches</a>
						}
					</div>
				}
			</div>
			if len(data.Searches) > 0 {
				<div class="card" style="overflow:hidden;">
					<table class="table" style="border:0; border-radius:0; box-shadow:none;">
						<thead>
							<tr>
								<th>Pattern</th>
								<th>Data Source</th>
								<th>Matches</th>
								<th>Created</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range data.Searches {
								<tr class="table__row--link">
									<td>
										<div style="display:flex; align-items:center; gap: var(--s-2); min-width:0;">
											<a href={ templ.SafeURL("/search/" + s.Search.ID.String()) } style="font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--text); background: var(--code-bg); padding: 2px 6px; border-radius: var(--r-xs); border: 1px solid var(--border); word-break: break-all; text-decoration:none;">{ s.Search.Term }</a>
											if s.Search.Private {
												@badge.Visibility(true)
											}
										</div>
									</td>
									<td>
										<span style="display:inline-flex; align-items:center; gap: var(--s-2); color: var(--text-dim); text-transform: capitalize;">
											<span style="color: var(--accent-text);">
												@icon.DataSource(s.Search.Repo, 14)
											</span>
											{ s.Search.Repo }
										</span>
									</td>
									<td>
										if s.MatchesKnown {
											<span style="color: var(--accent-text); font-family: var(--font-mono); font-weight:600; font-variant-numeric: tabular-nums;">{ ui.FormatNumber(s.MatchCount) }</span>
										} else {
											<span style="color: var(--text-faint);">—</span>
										}
									</td>
									<td style="color: var(--text-dim); font-family: var(--font-mono); font-size: var(--fs-micro);">{ s.Search.CreatedAt.Format("2006-01-02 15:04") }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if data.View == "own" {
					@shared.LinkPagination("/searches/own", data.Page, data.TotalPages)
				} else {
					@shared.LinkPagination("/searches", data.Page, data.TotalPages)
				}
			} else {
				<div class="empty">
					<div class="empty__icon">
						@icon.Search(28)
					</div>
					<div class="empty__title">No searches yet</div>
					if data.View == "own" {
						<p class="empty__body">You haven't performed any searches yet. Start exploring WordPress source code.</p>
					} else {
						<p class="empty__body">Start exploring WordPress source code with powerful regex patterns.</p>
					}
					<div style="margin-top: var(--s-5);">
						if data.SearchEnabled {
							<a href="/" class="btn btn--primary btn--lg">Start searching</a>
						} else {
							<span class="btn" aria-disabled="true" style="opacity:0.6; cursor:default;">
								@icon.Close(14)
								Search unavailable
							</span>
						}
					</div>
				</div>
			}
		</section>
	}
}
